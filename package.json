{
  "name": "angst",
  "private": true,
  "type": "module",
  "description": "Angst — planner semanal modular. modules/feed/ tiene su propio package.json (dependencias del pipeline de Actions, separadas de las del build principal).",
  "scripts": {
    "build": "node build/assemble.mjs",
    "audit:export": "node tests/export-coverage.mjs && node tests/vitrina-restore.mjs",
    "test:presupuesto": "node tests/presupuesto-modelo.mjs",
    "test:semana-salud": "node tests/semana-salud.mjs",
    "test:pokecripto-colecciones": "node tests/pokecripto-colecciones.mjs",
    "test:gcal": "node tests/gcal-sync.mjs",
    "test:familia": "node tests/familia-inbox.mjs",
    "test:rueda": "node tests/rueda-geometria.mjs",
    "test:torta": "node tests/torta-datos.mjs",
    "test:memoria": "node tests/compras-memoria.mjs",
    "test:fadiman": "node tests/fadiman-diario.mjs && node tests/fadiman-protocolo.mjs",
    "test:melee": "node tests/melee-orden.mjs",
    "test:musica": "node tests/musica.mjs && node tests/musica-megusta.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
